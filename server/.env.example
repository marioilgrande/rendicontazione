# Copia questo file come ".env" e compila con i tuoi dati Register.it

# SMTP Register.it
SMTP_HOST=authsmtp.register.it
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tuamail@tuodominio.it
SMTP_PASS=password_della_casella

# Mittente visualizzato
SMTP_FROM_NAME=Rendicontazione Acea
SMTP_FROM_EMAIL=tuamail@tuodominio.it

# Porta del server locale (default 5170)
PORT=5170

# Pausa fra una mail e l'altra (ms) per evitare rate-limit SMTP
SEND_DELAY_MS=600
